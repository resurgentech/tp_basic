# Telepatch twin of docker_images/Dockerfiles/ansible.redhat; see
# telepatch.debian for the conventions.
FROM parent

ARG PLAYBOOK_NAME
RUN --mount=type=bind,source=build/tp-basic,target=/tmp/tp-basic \
    --mount=type=bind,source=vars,target=/tmp/tp-vars \
    dnf clean all && \
    dnf update -y && \
    /tmp/tp-basic run container/${PLAYBOOK_NAME} --local --vars /tmp/tp-vars/container.toml

RUN dnf clean all && \
    rm -rf /var/cache/yum /tmp/*
