# Telepatch twin of docker_images/Dockerfiles/ansible.debian, built by
# scripts/test-container.sh with context = this repo. "parent" is the previous
# image in the chain (a --build-context). Preamble and cleanup mirror the
# ansible file line for line; only the ansible clone/run is replaced by the
# prebuilt static tp-basic. The mounts are under /tmp (never /usr/local/bin) so
# no mountpoint can show up in the oracle's /usr/local/bin capture, and the
# cleanup is a separate RUN because `rm -rf /tmp/*` cannot remove a live mount.
# The image-history step is left out: it is not part of the oracle.
FROM parent

ARG PLAYBOOK_NAME
RUN --mount=type=bind,source=build/tp-basic,target=/tmp/tp-basic \
    --mount=type=bind,source=vars,target=/tmp/tp-vars \
    apt-get update --fix-missing && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get upgrade -y && \
    /tmp/tp-basic run container/${PLAYBOOK_NAME} --local --vars /tmp/tp-vars/container.toml

RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
