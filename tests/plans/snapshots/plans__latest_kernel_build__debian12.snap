      |   if [ "$rc" -eq 0 ]; then
      |     for tp_n in "${tp_todo[@]}"; do
      |       tp_got=${tp_after[$tp_n]-}; tp_wv=${tp_wantv[$tp_n]-}
      |       if [ -z "$tp_got" ] || { [ -n "$tp_wv" ] && [ "$tp_got" != "$tp_wv" ]; }; then
      |         echo "telepatch: cargo $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |       fi
      |     done
      |   fi
      | fi
role rust_kernel
  #22 pkg as shell:root reads [] writes [pkg:libclang-dev] post [pkg:libclang-dev=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('libclang-dev')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | apt-get -q update || rc=$?
      | for tp_n in "${tp_want[@]}"; do
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$tp_n" 2>/dev/null)" = installed ] || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #23 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | tp_out=$(mktemp)
      | {
      | . ~/.cargo/env && rustup component add rust-src
      | } 2>&1 | tee "$tp_out"
      | rc=${PIPESTATUS[0]}
      | if [ "$rc" -eq 0 ] && grep -Eq 'downloading' "$tp_out"; then changed=1; fi
      | rm -f "$tp_out"
  #24 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if [ -e ~/.cargo/bin/bindgen ]; then
      |   skipped=1
      | else
      | . ~/.cargo/env && cargo install --locked bindgen-cli
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
