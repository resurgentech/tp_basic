---
source: tests/plans.rs
expression: text
---
host debian13 (os: Debian/Debian 13)
blocking reads: 0
shell helpers: undo fe76955f

window 1 (final)
role systemd_time
  #1 pkg as shell:root reads [] writes [pkg:tzdata] post [pkg:tzdata=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('tzdata')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l
      | tp_apt_present() {
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ] && return 0
      |   dpkg-query -W -f='${db:Status-Status} ${Provides}\n' 2>/dev/null | awk -v n="$1" '$1 != "installed" { next } { line=$0; sub(/^installed[[:space:]]+/, "", line); k=split(line, parts, /,/); for (i=1; i<=k; i++) { p=parts[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", p); sub(/[[:space:]].*/, "", p); if (p == n) found=1 } } END { exit (found ? 0 : 1) }'
      | }
      | for tp_n in "${tp_want[@]}"; do
      |   tp_apt_present "$tp_n" || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #2 timezone as shell:root reads [pkg:tzdata] writes [file:/etc/localtime, timezone] post [file:/etc/localtime=Exists(true), timezone="America/Los_Angeles"]
      | [ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
      | tp_r="${TP_TZ_ROOT-}"
      | tp_cur() { local l; l=$(readlink -- "$tp_r/etc/localtime" 2>/dev/null) || return 0; case $l in */zoneinfo/*) printf '%s' "${l#*/zoneinfo/}";; esac; }
      | tp_z='America/Los_Angeles'
      | tp_deb=1
      | tp_set() {
      |   tp_sbx "$tp_r/etc/localtime" "$tp_r/etc/timezone" "$tp_r/usr/share/zoneinfo" || return 1
      |   if [ ! -f "$tp_r/usr/share/zoneinfo/$tp_z" ]; then
      |     echo "telepatch: timezone $tp_z: no zoneinfo (install tzdata)" >&2
      |     return 1
      |   fi
      |   tp_wz=$(tp_cur)
      |   [ "$tp_wz" != "$tp_z" ] || return 0
      |   if [ -d "${TP_SVC_RUNDIR:-/run/systemd/system}" ] && command -v timedatectl >/dev/null 2>&1; then
      |     timedatectl set-timezone "$tp_z" || return 1
      |   else
      |     ln -sf -- "/usr/share/zoneinfo/$tp_z" "$tp_r/etc/localtime" || return 1
      |   fi
      |   if [ "$tp_deb" = 1 ]; then printf '%s\n' "$tp_z" > "$tp_r/etc/timezone" || return 1; fi
      |   changed=1
      | }
      | tp_set || rc=1
