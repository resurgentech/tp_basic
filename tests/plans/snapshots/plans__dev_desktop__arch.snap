      |       tp_got=${tp_have[$tp_n]-}; tp_got=${tp_got# }
      |       echo "telepatch: mise $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |     done
      |   fi
