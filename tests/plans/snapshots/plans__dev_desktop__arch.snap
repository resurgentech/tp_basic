---
source: tests/plans.rs
expression: text
---
host arch (os: Arch/Arch 20261025.0.616225)
blocking reads: 0

window 1 (final)
role admin_users
  #1 file as shell:root reads [] writes [file:/etc/sudoers] post [file:/etc/sudoers=Exists(true)]
      | rc=0; changed=0
      | tp_p='/etc/sudoers'
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_c=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   if [ -f "$tp_p" ]; then cat "$tp_p" > "$tp_c" || rc=$?; fi
      | tp_append() {
      |   if [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ]; then printf '\n' >> "$1"; fi
      |   printf '%s\n' "$2" >> "$1"
      | }
      | if [ "$rc" -eq 0 ]; then
      |   if [ ! -e "$tp_c" ]; then (umask 022; : > "$tp_c") && changed=1 || rc=$?; fi
      |   tp_l='@includedir /etc/sudoers.d'
      |   tp_n=$(grep -nE -- '^[#@]includedir\s+/etc/sudoers\.d' "$tp_c" | tail -n 1 | cut -d: -f1)
      |   if [ "$rc" -ne 0 ]; then :
      |   elif [ -z "$tp_n" ]; then
      |     if tp_append "$tp_c" "$tp_l"; then changed=1; else rc=$?; fi
      |   elif [ "$(sed -n "${tp_n}p" "$tp_c")" != "$tp_l" ]; then
      |     tp_t=$(mktemp) && TP_L="$tp_l" awk -v n="$tp_n" 'NR==n { print ENVIRON["TP_L"]; next } { print }' "$tp_c" > "$tp_t" && cat "$tp_t" > "$tp_c"
      |     rc=$?
      |     rm -f "$tp_t"
      |     if [ "$rc" -eq 0 ]; then changed=1; fi
      |   fi
      | fi
      |   changed=0
      |   if [ "$rc" -eq 0 ] && { [ ! -e "$tp_p" ] || ! cmp -s "$tp_c" "$tp_p"; }; then
      |     if [ -e "$tp_p" ]; then chmod --reference="$tp_p" "$tp_c" || rc=$?; else chmod 644 "$tp_c" || rc=$?; fi
      |     if [ "$rc" -eq 0 ] && [ -e "$tp_p" ]; then chown --reference="$tp_p" "$tp_c" 2>/dev/null; fi
      |     if [ "$rc" -eq 0 ]; then
      |       tp_vc='visudo -cf "$tp_c"'
      |       ( eval "$tp_vc" ) || rc=$?
      |     fi
      |     if [ "$rc" -eq 0 ]; then
      |       mv -f "$tp_c" "$tp_p"; rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |     fi
      |   fi
      |   rm -f "$tp_c"
      | fi
