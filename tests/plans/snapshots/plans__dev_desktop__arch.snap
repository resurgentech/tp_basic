role node
  #31 pkg[mise] as shell:root reads [] writes [*] post [pkg:mise:root:node=Installed, file:/etc/mise/config.toml=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_want=('node')
      | declare -A tp_have=() tp_before=() tp_spec=() tp_wantv=()
      | tp_todo=(); tp_args=()
      | tp_cfgdir=${MISE_SYSTEM_CONFIG_DIR:-/etc/mise}; tp_data=${MISE_SYSTEM_DATA_DIR:-/usr/local/share/mise}
      | tp_mise=$(command -v mise 2>/dev/null) || tp_mise=
      | [ -n "$tp_mise" ] || { [ -x /usr/local/bin/mise ] && tp_mise=/usr/local/bin/mise; }
      | tp_list() { awk -v pre="$tp_data/installs/" '/^  "[^"]+": \[/ { t=$0; sub(/^  "/, "", t); sub(/": \[.*/, "", t); next }
      | /"version":/ { v=$0; sub(/.*"version": "/, "", v); sub(/".*/, "", v) }
      | /"install_path":/ { p=$0; sub(/.*"install_path": "/, "", p); sub(/".*/, "", p); if (index(p, pre) == 1) print t, v }'; }
      | tp_read() { local n v; tp_have=(); while read -r n v; do tp_have[$n]+=" $v"; done < <("$tp_mise" ls --json --installed 2>/dev/null | tp_list); }
      | tp_has() { case "${tp_have[$1]-} " in *" $2 "*) return 0;; esac; return 1; }
      | if [ -z "$tp_mise" ]; then echo 'telepatch: mise not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_read
      |   for tp_k in "${!tp_have[@]}"; do tp_before[$tp_k]=${tp_have[$tp_k]}; done
      |   for tp_n in "${tp_want[@]}"; do
      |     tp_spec[$tp_n]=latest
      |     [ -n "${tp_have[$tp_n]-}" ] || { tp_todo+=("$tp_n"); tp_args+=("$tp_n"); }
      |   done
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   mkdir -p "$tp_cfgdir" && { [ -e "$tp_cfgdir/config.toml" ] || : > "$tp_cfgdir/config.toml"; } || rc=1
      |   for tp_n in "${tp_want[@]}"; do
      |     [ "$rc" -eq 0 ] || break
      |     tp_cur=$("$tp_mise" config get --system "tools.$tp_n" 2>/dev/null) || tp_cur=
      |     if [ "$tp_cur" != "${tp_spec[$tp_n]}" ]; then
      |       if "$tp_mise" config set --system "tools.$tp_n" "${tp_spec[$tp_n]}"; then changed=1; else rc=1; fi
      |     fi
      |   done
      | fi
      | if [ "$rc" -eq 0 ] && [ "${#tp_todo[@]}" -gt 0 ]; then
      |   "$tp_mise" install --system "${tp_args[@]}"
      |   rc=$?
      |   tp_read
      |   for tp_n in "${tp_want[@]}"; do
      |     if [ "${tp_have[$tp_n]-}" != "${tp_before[$tp_n]-}" ]; then changed=1; installed+=("$tp_n"); fi
      |   done
      |   if [ "$rc" -eq 0 ]; then
      |     for tp_n in "${tp_todo[@]}"; do
      |       tp_wv=${tp_wantv[$tp_n]-}
      |       if [ -n "$tp_wv" ]; then tp_has "$tp_n" "$tp_wv" && continue; else [ -n "${tp_have[$tp_n]-}" ] && continue; fi
      |       tp_got=${tp_have[$tp_n]-}; tp_got=${tp_got# }
      |       echo "telepatch: mise $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |     done
      |   fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_noshim=0
      |   for tp_n in "${tp_want[@]}"; do
      |     for tp_b in "$tp_data/installs/$tp_n"/*/bin/*; do
      |       [ -e "$tp_b" ] || continue
      |       [ -e "$tp_data/shims/${tp_b##*/}" ] || { tp_noshim=1; break 2; }
      |     done
      |   done
      |   if [ "$tp_noshim" -eq 1 ]; then
      |     if "$tp_mise" reshim --system; then changed=1; else rc=$?; fi
      |   fi
      | fi
role golang
  #34 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:go=Installed, file:/usr/local/go/bin/go=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='go'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/go/bin/go' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | /usr/local/go/bin/go version
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_latest=$( (
      | curl -fsSL 'https://go.dev/VERSION?m=text' | head -n1
      | ) 2>/dev/null | tp_tok)
      | tp_want_v=$tp_latest
      | if [ -z "$tp_want_v" ]; then echo "telepatch: script "'go'": could not resolve the latest version" >&2; rc=1; fi
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
      |   if [ "$tp_have" -eq 0 ]; then tp_act=install
      |   elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
      |   fi
      | fi
      | if [ "$tp_act" = install ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (
      | set -eu
      | case "$(uname -m)" in
      |   x86_64) a=amd64 ;;
      |   aarch64) a=arm64 ;;
      |   *) echo "golang: unsupported architecture $(uname -m)" >&2; exit 1 ;;
      | esac
      | f="go$TP_WANT.linux-$a.tar.gz"
      | d=$(mktemp -d)
      | trap 'rm -rf "$d"' EXIT
      | curl -fsSL -o "$d/$f" "https://go.dev/dl/$f"
      | curl -fsSL -o "$d/dl.json" 'https://go.dev/dl/?mode=json'
      | sum=$(awk -v f="$f" '
      |   /"filename"/ { hit = (index($0, "\"" f "\"") > 0) }
      |   hit && /"sha256"/ { gsub(/.*"sha256"[ \t]*:[ \t]*"/, ""); gsub(/".*/, ""); print; exit }
      | ' "$d/dl.json")
      | case "$sum" in
      |   *[!0-9a-f]*|"") echo "golang: no sha256 for $f in go.dev/dl/?mode=json" >&2; exit 1 ;;
      | esac
      | [ "${#sum}" -eq 64 ] || { echo "golang: bad sha256 for $f" >&2; exit 1; }
      | printf '%s  %s\n' "$sum" "$f" > "$d/sum"
      | (cd "$d" && sha256sum -c sum >/dev/null) || { echo "golang: sha256 mismatch for $f" >&2; exit 1; }
      | rm -rf /usr/local/go
      | tar -C /usr/local -xzf "$d/$f"
      | )
      |   )
      |   rc=$?
      | elif [ "$tp_act" = update ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (
      | set -eu
      | case "$(uname -m)" in
      |   x86_64) a=amd64 ;;
      |   aarch64) a=arm64 ;;
      |   *) echo "golang: unsupported architecture $(uname -m)" >&2; exit 1 ;;
      | esac
      | f="go$TP_WANT.linux-$a.tar.gz"
      | d=$(mktemp -d)
      | trap 'rm -rf "$d"' EXIT
      | curl -fsSL -o "$d/$f" "https://go.dev/dl/$f"
      | curl -fsSL -o "$d/dl.json" 'https://go.dev/dl/?mode=json'
      | sum=$(awk -v f="$f" '
      |   /"filename"/ { hit = (index($0, "\"" f "\"") > 0) }
      |   hit && /"sha256"/ { gsub(/.*"sha256"[ \t]*:[ \t]*"/, ""); gsub(/".*/, ""); print; exit }
      | ' "$d/dl.json")
      | case "$sum" in
      |   *[!0-9a-f]*|"") echo "golang: no sha256 for $f in go.dev/dl/?mode=json" >&2; exit 1 ;;
      | esac
      | [ "${#sum}" -eq 64 ] || { echo "golang: bad sha256 for $f" >&2; exit 1; }
      | printf '%s  %s\n' "$sum" "$f" > "$d/sum"
      | (cd "$d" && sha256sum -c sum >/dev/null) || { echo "golang: sha256 mismatch for $f" >&2; exit 1; }
      | rm -rf /usr/local/go
      | tar -C /usr/local -xzf "$d/$f"
      | )
      |   )
      |   rc=$?
      | fi
      | if [ -n "$tp_act" ]; then
      |   tp_probe
      |   if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
      |   if [ "$rc" -eq 0 ]; then
      |     if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
      |     if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      |       echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
      |     fi
      |   fi
      | fi
  #35 file as shell:root reads [] writes [file:/etc/profile.d/go.sh] post [file:/etc/profile.d/go.sh=Exists(true)]
      | rc=0; changed=0
      | tp_p='/etc/profile.d/go.sh'
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | tp_b='ZXhwb3J0IFBBVEg9IiRQQVRIOi91c3IvbG9jYWwvZ28vYmluIgo='
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && printf %s "$tp_b" | base64 -d | cmp -s - "$tp_p"; }; then
      |   tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      |   if [ "$rc" -eq 0 ]; then
      |     if printf %s "$tp_b" | base64 -d > "$tp_t"; then
      |       if [ -e "$tp_p" ]; then
      |         chmod --reference="$tp_p" "$tp_t"; chown --reference="$tp_p" "$tp_t" 2>/dev/null
      |       else
      |         chmod 644 "$tp_t"
      |       fi
      |       mv -f "$tp_t" "$tp_p"; rc=$?
      |     else
      |       rc=$?
      |     fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
      | if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '644' ]; then
      |   if chmod 644 "$tp_p"; then changed=1; else rc=$?; fi
      | fi
role rust_build
  #38 pkg as shell:root reads [] writes [pkg:clang, pkg:musl, pkg:openssl, pkg:pkgconf] post [pkg:clang=Installed, pkg:musl=Installed, pkg:openssl=Installed, pkg:pkgconf=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('openssl' 'pkgconf' 'clang' 'musl')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   if [ -z "$(pacman -T "$tp_n" 2>/dev/null)" ] || [ -n "$(pacman -Qqg "$tp_n" 2>/dev/null)" ]; then :; else tp_missing+=("$tp_n"); fi
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   pacman -S --needed --noconfirm "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi

window 2 (final)
role rust_build
  #39 pkg[rustup] as login:bot reads [] writes [*] post [pkg:rustup:bot:stable=Installed, pkg:rustup:bot:stable/target/x86_64-unknown-linux-musl=Installed]
      | rc=0; changed=0; installed=()
      | tp_tc='stable'
      | tp_prof='default'
      | tp_path() {
      |   tp_cb=${CARGO_HOME:-$HOME/.cargo}/bin
      |   if [ -d "$tp_cb" ]; then case ":$PATH:" in *":$tp_cb:"*) ;; *) PATH=$tp_cb:$PATH;; esac; fi
      | }
