role dev_common
  #11 pkg as shell:root reads [] writes [pkg:base-devel, pkg:bc, pkg:clang, pkg:cmake, pkg:cpio, pkg:git, pkg:gnupg, pkg:lld, pkg:llvm, pkg:python, pkg:python-gitpython, pkg:python-jinja, pkg:python-pip, pkg:python-pytest, pkg:python-yaml, pkg:rsync, pkg:wget, pkg:xmlto, pkg:zstd] post [pkg:base-devel=Installed, pkg:bc=Installed, pkg:clang=Installed, pkg:cmake=Installed, pkg:cpio=Installed, pkg:git=Installed, pkg:gnupg=Installed, pkg:lld=Installed, pkg:llvm=Installed, pkg:python=Installed, pkg:python-gitpython=Installed, pkg:python-jinja=Installed, pkg:python-pip=Installed, pkg:python-pytest=Installed, pkg:python-yaml=Installed, pkg:rsync=Installed, pkg:wget=Installed, pkg:xmlto=Installed, pkg:zstd=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('base-devel' 'cmake' 'clang' 'llvm' 'lld' 'git' 'rsync' 'gnupg' 'bc' 'cpio' 'xmlto' 'zstd' 'wget' 'python' 'python-pip' 'python-yaml' 'python-jinja' 'python-gitpython' 'python-pytest')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   if [ -z "$(pacman -T "$tp_n" 2>/dev/null)" ] || [ -n "$(pacman -Qqg "$tp_n" 2>/dev/null)" ]; then :; else tp_missing+=("$tp_n"); fi
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   pacman -S --needed --noconfirm "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
  #12 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:uv=Installed, file:/usr/local/bin/uv=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='uv'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/bin/uv' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | uv self version --short
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_want_v=
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
      |   if [ "$tp_have" -eq 0 ]; then tp_act=install
      |   elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
      |   fi
      | fi
      | if [ "$tp_act" = install ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (set -o pipefail && curl -LsSf https://astral.sh/uv/install.sh | UV_NO_MODIFY_PATH=1 UV_INSTALL_DIR=/usr/local/bin sh)
      |   )
      |   rc=$?
      | elif [ "$tp_act" = update ]; then
      |   ( export TP_WANT="$tp_want_v"
      | uv self update
      |   )
      |   rc=$?
      | fi
      | if [ -n "$tp_act" ]; then
      |   tp_probe
      |   if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
      |   if [ "$rc" -eq 0 ]; then
      |     if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
      |     if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      |       echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
      |     fi
      |   fi
      | fi
