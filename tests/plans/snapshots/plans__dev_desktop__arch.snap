  #3 user as shell:root reads [group:wheel] writes [user:bot] post [user:bot=Exists(true)]
      | created=0
      | tp_u='bot'
      | for tp_g in 'wheel'; do
      |   if ! getent group "$tp_g" >/dev/null 2>&1; then
      |     echo "telepatch: user $tp_u: group $tp_g does not exist" >&2
      |     rc=1
      |   fi
      | done
      | if [ "$rc" -eq 0 ]; then
      | if ! getent passwd "$tp_u" >/dev/null 2>&1; then
      |   useradd -m -s '/bin/bash' -G 'wheel' -- "$tp_u"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; created=1; fi
      | else
      |   :
      |   tp_cur=$(getent passwd "$tp_u" | cut -d: -f7)
      |   if [ "$tp_cur" != '/bin/bash' ]; then
      |     usermod -s '/bin/bash' -- "$tp_u"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; fi
      |   fi
      |   if [ "$rc" -eq 0 ]; then
      |     tp_have=" $(id -nG "$tp_u") "
      |     tp_add=
      |     for tp_g in 'wheel'; do
      |       case "$tp_have" in *" $tp_g "*) ;; *) tp_add="$tp_add,$tp_g";; esac
      |     done
      |     if [ -n "$tp_add" ]; then
      |       usermod -aG "${tp_add#,}" -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |     fi
      |   fi
      | fi
      | fi
