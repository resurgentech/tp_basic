  #6 pkg as shell:root reads [] writes [pkg:clang, pkg:gcc-c++, pkg:musl-gcc, pkg:openssl-devel, pkg:pkgconf-pkg-config] post [pkg:clang=Installed, pkg:gcc-c++=Installed, pkg:musl-gcc=Installed, pkg:openssl-devel=Installed, pkg:pkgconf-pkg-config=Installed]
