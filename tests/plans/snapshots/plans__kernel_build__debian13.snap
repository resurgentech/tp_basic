      | rc=0; changed=0; installed=()
      | tp_want=('python3-apt' 'python3-pip' 'build-essential' 'cmake' 'clang' 'llvm' 'lld' 'git' 'rsync' 'gcc' 'gnupg' 'rpm' 'cppcheck' 'autoconf' 'asciidoc' 'bc' 'cpio' 'bison' 'flex' 'gawk' 'gettext' 'gzip' 'hostname' 'm4' 'net-tools' 'openssl' 'xmlto' 'zstd' 'diffstat' 'sshpass' 'btop' 'acl' 'curl' 'python3-jinja2' 'python3-git' 'python3-yaml' 'python3-hvac')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive
      | for tp_n in "${tp_want[@]}"; do
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$tp_n" 2>/dev/null)" = installed ] || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
      merged from dev_common #1, dev_common #2, dev_common #3
  #4 sh as shell:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if [ -e /usr/local/bin/uv ]; then
      |   skipped=1
      | else
      | (set -o pipefail && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh)
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
role src_repos
  #7 sh as shell:root reads [] writes [file:/etc/apt/sources.list.d/*.sources]
      | rc=0; changed=0; skipped=0
      | if { ! ls /etc/apt/sources.list.d/*.sources >/dev/null 2>&1 || grep -qs '^Types:.*deb-src' /etc/apt/sources.list.d/*.sources; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | tp_out=$(mktemp)
      | {
      | sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/*.sources
      | echo SOURCES_CHANGED
      | } 2>&1 | tee "$tp_out"
      | rc=${PIPESTATUS[0]}
      | if [ "$rc" -eq 0 ] && grep -Eq 'SOURCES_CHANGED' "$tp_out"; then changed=1; fi
      | rm -f "$tp_out"
      | fi
role kernel_build
  #10 pkg as shell:root reads [] writes [pkg:dkms, pkg:dwarves, pkg:equivs, pkg:libelf-dev, pkg:libiberty-dev, pkg:libncurses-dev, pkg:libpci-dev, pkg:libssl-dev, pkg:libudev-dev] post [pkg:dkms=Installed, pkg:dwarves=Installed, pkg:equivs=Installed, pkg:libelf-dev=Installed, pkg:libiberty-dev=Installed, pkg:libncurses-dev=Installed, pkg:libpci-dev=Installed, pkg:libssl-dev=Installed, pkg:libudev-dev=Installed]
