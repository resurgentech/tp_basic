role dev_common
  #13 pkg as shell:root reads [] writes [pkg:@Development Tools, pkg:bc, pkg:bison, pkg:clang, pkg:cmake, pkg:dpkg, pkg:dpkg-dev, pkg:dpkg-devel, pkg:flex, pkg:gcc, pkg:git, pkg:gnupg, pkg:lld, pkg:llvm, pkg:net-tools, pkg:newt, pkg:python3, pkg:python3-devel, pkg:python3-docutils, pkg:python3-pip, pkg:rpm-build, pkg:rsync, pkg:slang, pkg:xmlto, pkg:zlib-devel, pkg:zstd] post [pkg:@Development Tools=Installed, pkg:bc=Installed, pkg:bison=Installed, pkg:clang=Installed, pkg:cmake=Installed, pkg:dpkg=Installed, pkg:dpkg-dev=Installed, pkg:dpkg-devel=Installed, pkg:flex=Installed, pkg:gcc=Installed, pkg:git=Installed, pkg:gnupg=Installed, pkg:lld=Installed, pkg:llvm=Installed, pkg:net-tools=Installed, pkg:newt=Installed, pkg:python3=Installed, pkg:python3-devel=Installed, pkg:python3-docutils=Installed, pkg:python3-pip=Installed, pkg:rpm-build=Installed, pkg:rsync=Installed, pkg:slang=Installed, pkg:xmlto=Installed, pkg:zlib-devel=Installed, pkg:zstd=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('@Development Tools' 'cmake' 'clang' 'llvm' 'lld' 'bison' 'flex' 'git' 'rsync' 'gcc' 'zlib-devel' 'gnupg' 'bc' 'newt' 'slang' 'xmlto' 'net-tools' 'rpm-build' 'dpkg-devel' 'dpkg' 'dpkg-dev' 'zstd' 'python3' 'python3-devel' 'python3-docutils' 'python3-pip')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   case "$tp_n" in
      |     @*) dnf group list --installed 2>/dev/null | grep -qF -- "${tp_n#@}" || tp_missing+=("$tp_n");;
      |     *) rpm -q --whatprovides "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n");;
      |   esac
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   dnf install -y "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
  #14 pkg as shell:root reads [] writes [pkg:pip:GitPython, pkg:pip:PyYAML, pkg:pip:jinja2] post [pkg:pip:GitPython=Installed, pkg:pip:PyYAML=Installed, pkg:pip:jinja2=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('jinja2' 'GitPython' 'PyYAML')
      | tp_missing=()
      | if python3 -m pip --version >/dev/null 2>&1; then tp_pip=(python3 -m pip)
      | elif command -v pip3 >/dev/null 2>&1; then tp_pip=(pip3)
      | else echo 'telepatch: pip not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   for tp_n in "${tp_want[@]}"; do
      |     "${tp_pip[@]}" show "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n")
      |   done
      |   if [ "${#tp_missing[@]}" -gt 0 ]; then
      |     "${tp_pip[@]}" install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #15 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:uv=Installed, file:/usr/local/bin/uv=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='uv'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/bin/uv' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | uv self version --short
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_want_v=
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
