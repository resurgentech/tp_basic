role dev_common
  #1 pkg as shell:root reads [] writes [pkg:base-devel, pkg:bc, pkg:clang, pkg:cmake, pkg:cpio, pkg:git, pkg:gnupg, pkg:lld, pkg:llvm, pkg:python, pkg:python-gitpython, pkg:python-jinja, pkg:python-pip, pkg:python-pytest, pkg:python-yaml, pkg:rsync, pkg:wget, pkg:xmlto, pkg:zstd] post [pkg:base-devel=Installed, pkg:bc=Installed, pkg:clang=Installed, pkg:cmake=Installed, pkg:cpio=Installed, pkg:git=Installed, pkg:gnupg=Installed, pkg:lld=Installed, pkg:llvm=Installed, pkg:python=Installed, pkg:python-gitpython=Installed, pkg:python-jinja=Installed, pkg:python-pip=Installed, pkg:python-pytest=Installed, pkg:python-yaml=Installed, pkg:rsync=Installed, pkg:wget=Installed, pkg:xmlto=Installed, pkg:zstd=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('base-devel' 'cmake' 'clang' 'llvm' 'lld' 'git' 'rsync' 'gnupg' 'bc' 'cpio' 'xmlto' 'zstd' 'wget' 'python' 'python-pip' 'python-yaml' 'python-jinja' 'python-gitpython' 'python-pytest')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   if [ -z "$(pacman -T "$tp_n" 2>/dev/null)" ] || [ -n "$(pacman -Qqg "$tp_n" 2>/dev/null)" ]; then :; else tp_missing+=("$tp_n"); fi
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   pacman -S --needed --noconfirm "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
  #2 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:uv=Installed, file:/usr/local/bin/uv=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='uv'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/bin/uv' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | uv self version --short
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_want_v=
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
      |   if [ "$tp_have" -eq 0 ]; then tp_act=install
      |   elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
      |   fi
      | fi
      | if [ "$tp_act" = install ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (set -o pipefail && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh)
      |   )
      |   rc=$?
      | elif [ "$tp_act" = update ]; then
      |   ( export TP_WANT="$tp_want_v"
      | uv self update
      |   )
      |   rc=$?
      | fi
      | if [ -n "$tp_act" ]; then
      |   tp_probe
      |   if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
      |   if [ "$rc" -eq 0 ]; then
      |     if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
      |     if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      |       echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
      |     fi
      |   fi
      | fi
  #3 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:mise=Installed, file:/usr/local/bin/mise=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='mise'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/bin/mise' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | mise version
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_want_v=
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
      |   if [ "$tp_have" -eq 0 ]; then tp_act=install
      |   elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
      |   fi
      | fi
      | if [ "$tp_act" = install ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (set -o pipefail && curl -fsSL https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh)
      |   )
      |   rc=$?
      | elif [ "$tp_act" = update ]; then
      |   ( export TP_WANT="$tp_want_v"
      | mise self-update -y
      |   )
      |   rc=$?
      | fi
      | if [ -n "$tp_act" ]; then
      |   tp_probe
      |   if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
      |   if [ "$rc" -eq 0 ]; then
      |     if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
      |     if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      |       echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
      |     fi
      |   fi
      | fi
  #4 file as shell:root reads [] writes [file:/etc/profile.d/mise.sh] post [file:/etc/profile.d/mise.sh=Exists(true)]
      | rc=0; changed=0
      | tp_p='/etc/profile.d/mise.sh'
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | tp_b='IyBtaXNlIHN5c3RlbSBzaGltcyBmb3IgbG9naW4gc2hlbGxzICh0ZWxlcGF0Y2ggZGV2X2NvbW1vbikKZXhwb3J0IFBBVEg9Ii91c3IvbG9jYWwvc2hhcmUvbWlzZS9zaGltczokUEFUSCIK'
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && printf %s "$tp_b" | base64 -d | cmp -s - "$tp_p"; }; then
      |   tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      |   if [ "$rc" -eq 0 ]; then
      |     if printf %s "$tp_b" | base64 -d > "$tp_t"; then
      |       if [ -e "$tp_p" ]; then
      |         chmod --reference="$tp_p" "$tp_t"; chown --reference="$tp_p" "$tp_t" 2>/dev/null
      |       else
      |         chmod 644 "$tp_t"
      |       fi
      |       mv -f "$tp_t" "$tp_p"; rc=$?
      |     else
      |       rc=$?
      |     fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
      | if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '644' ]; then
      |   if chmod 644 "$tp_p"; then changed=1; else rc=$?; fi
      | fi
  #5 pkg[mise] as shell:root reads [] writes [*] post [pkg:mise:root:just=Installed, file:/etc/mise/config.toml=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_want=('just')
      | declare -A tp_have=() tp_before=() tp_spec=() tp_wantv=()
      | tp_todo=(); tp_args=()
      | tp_cfgdir=${MISE_SYSTEM_CONFIG_DIR:-/etc/mise}; tp_data=${MISE_SYSTEM_DATA_DIR:-/usr/local/share/mise}
      | tp_mise=$(command -v mise 2>/dev/null) || tp_mise=
      | [ -n "$tp_mise" ] || { [ -x /usr/local/bin/mise ] && tp_mise=/usr/local/bin/mise; }
      | tp_list() { awk -v pre="$tp_data/installs/" '/^  "[^"]+": \[/ { t=$0; sub(/^  "/, "", t); sub(/": \[.*/, "", t); next }
      | /"version":/ { v=$0; sub(/.*"version": "/, "", v); sub(/".*/, "", v) }
      | /"install_path":/ { p=$0; sub(/.*"install_path": "/, "", p); sub(/".*/, "", p); if (index(p, pre) == 1) print t, v }'; }
      | tp_read() { local n v; tp_have=(); while read -r n v; do tp_have[$n]+=" $v"; done < <("$tp_mise" ls --json --installed 2>/dev/null | tp_list); }
      | tp_has() { case "${tp_have[$1]-} " in *" $2 "*) return 0;; esac; return 1; }
      | if [ -z "$tp_mise" ]; then echo 'telepatch: mise not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_read
      |   for tp_k in "${!tp_have[@]}"; do tp_before[$tp_k]=${tp_have[$tp_k]}; done
      |   for tp_n in "${tp_want[@]}"; do
      |     tp_spec[$tp_n]=latest
      |     [ -n "${tp_have[$tp_n]-}" ] || { tp_todo+=("$tp_n"); tp_args+=("$tp_n"); }
      |   done
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   mkdir -p "$tp_cfgdir" && { [ -e "$tp_cfgdir/config.toml" ] || : > "$tp_cfgdir/config.toml"; } || rc=1
      |   for tp_n in "${tp_want[@]}"; do
      |     [ "$rc" -eq 0 ] || break
      |     tp_cur=$("$tp_mise" config get --system "tools.$tp_n" 2>/dev/null) || tp_cur=
      |     if [ "$tp_cur" != "${tp_spec[$tp_n]}" ]; then
      |       if "$tp_mise" config set --system "tools.$tp_n" "${tp_spec[$tp_n]}"; then changed=1; else rc=1; fi
      |     fi
      |   done
      | fi
      | if [ "$rc" -eq 0 ] && [ "${#tp_todo[@]}" -gt 0 ]; then
      |   "$tp_mise" install --system "${tp_args[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then "$tp_mise" reshim --system; rc=$?; fi
      |   tp_read
      |   for tp_n in "${tp_want[@]}"; do
      |     if [ "${tp_have[$tp_n]-}" != "${tp_before[$tp_n]-}" ]; then changed=1; installed+=("$tp_n"); fi
      |   done
      |   if [ "$rc" -eq 0 ]; then
      |     for tp_n in "${tp_todo[@]}"; do
      |       tp_wv=${tp_wantv[$tp_n]-}
      |       if [ -n "$tp_wv" ]; then tp_has "$tp_n" "$tp_wv" && continue; else [ -n "${tp_have[$tp_n]-}" ] && continue; fi
      |       tp_got=${tp_have[$tp_n]-}; tp_got=${tp_got# }
      |       echo "telepatch: mise $tp_n: installed ${tp_got:-absent}, wanted ${tp_wv:-present}" >&2; rc=1
      |     done
      |   fi
      | fi
