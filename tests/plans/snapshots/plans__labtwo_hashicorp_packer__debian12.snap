  #9 repo as shell:root reads [] writes [file:/etc/apt/keyrings/hashicorp.asc, file:/etc/apt/sources.list.d/hashicorp.sources, repo:hashicorp] post [file:/etc/apt/keyrings/hashicorp.asc=Exists(true), file:/etc/apt/sources.list.d/hashicorp.sources=Exists(true), repo:hashicorp=Exists(true)]
      | [ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
      | tp_n='hashicorp'
      | tp_fetch() {
      |   if ! command -v curl >/dev/null 2>&1; then
      |     echo "telepatch: repo $tp_n: curl not found" >&2
      |     return 1
      |   fi
      |   (umask 022; mkdir -p -- "$(dirname -- "$2")") || return 1
      |   tp_t=$(mktemp "$2.XXXXXX") || return 1
      |   if curl -fsSL -o "$tp_t" --url "$1" && chmod 0644 "$tp_t" && mv -f -- "$tp_t" "$2"; then
      |     return 0
      |   fi
      |   rm -f -- "$tp_t"
      |   return 1
      | }
      | tp_put() {
      |   if [ -f "$1" ] && [ "$(tp_render "$2" | sha256sum | cut -d' ' -f1)" = "$(sha256sum < "$1" | cut -d' ' -f1)" ]; then return 0; fi
      |   tp_new=
      |   if [ -e "$1" ] || [ -L "$1" ]; then tp_was "$1"; tp_save "$1" || return 1; else tp_new=1; fi
      |   (umask 022; mkdir -p -- "$(dirname -- "$1")") || return 1
      |   tp_t=$(mktemp "$1.XXXXXX") || return 1
      |   if tp_render "$2" > "$tp_t" && chmod 0644 "$tp_t" && mv -f -- "$tp_t" "$1"; then
      |     changed=1
      |     [ -z "$tp_new" ] || tp_fc=1
      |     return 0
      |   fi
      |   rm -f -- "$tp_t"
      |   return 1
      | }
      | tp_render() { printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: %s\nArchitectures: %s\nSigned-By: %s\n' 'https://apt.releases.hashicorp.com' 'bookworm' 'main' "$1" '/etc/apt/keyrings/hashicorp.asc'; }
      | tp_key='/etc/apt/keyrings/hashicorp.asc'
      | tp_src='/etc/apt/sources.list.d/hashicorp.sources'
      | if [ ! -e "$tp_key" ]; then
      |   if tp_fetch 'https://apt.releases.hashicorp.com/gpg' "$tp_key"; then changed=1; tp_kc=1; else rc=1; fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_arch=$(dpkg --print-architecture)
      |   if [ -z "$tp_arch" ]; then
      |     echo "telepatch: repo $tp_n: cannot read the dpkg architecture" >&2
      |     rc=1
      |   elif ! tp_put "$tp_src" "$tp_arch"; then
      |     rc=1
      |   fi
      | fi
