window 1 (final)
role vm_server
  #1 pkg as shell:root reads [] writes [pkg:bridge-utils, pkg:ca-certificates, pkg:curl, pkg:libvirt-clients, pkg:libvirt-daemon-system, pkg:qemu-system-x86, pkg:virtinst] post [pkg:bridge-utils=Installed, pkg:ca-certificates=Installed, pkg:curl=Installed, pkg:libvirt-clients=Installed, pkg:libvirt-daemon-system=Installed, pkg:qemu-system-x86=Installed, pkg:virtinst=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('qemu-system-x86' 'libvirt-daemon-system' 'libvirt-clients' 'virtinst' 'bridge-utils' 'curl' 'ca-certificates')
      | tp_missing=()
      | export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l
      | tp_apt_present() {
      |   [ "$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" = installed ] && return 0
      |   dpkg-query -W -f='${db:Status-Status} ${Provides}\n' 2>/dev/null | awk -v n="$1" '$1 != "installed" { next } { line=$0; sub(/^installed[[:space:]]+/, "", line); k=split(line, parts, /,/); for (i=1; i<=k; i++) { p=parts[i]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", p); sub(/[[:space:]].*/, "", p); if (p == n) found=1 } } END { exit (found ? 0 : 1) }'
      | }
      | for tp_n in "${tp_want[@]}"; do
      |   tp_apt_present "$tp_n" || tp_missing+=("$tp_n")
      | done
      | if [ "$rc" -eq 0 ] && [ "${#tp_missing[@]}" -gt 0 ]; then
      |   if ! find /var/lib/apt/lists -maxdepth 1 -type f ! -name lock 2>/dev/null | grep -q .; then apt-get -q update || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
      merged from vm_server #1, hashicorp_packer #6
  #2 svc as shell:root reads [] writes [svc:libvirtd.socket] post [svc:libvirtd.socket=Exists(true)]
      | tp_u='libvirtd.socket'
      | tp_run="${TP_SVC_RUNDIR:-/run/systemd/system}"
      | tp_skip=0
      | if ! command -v systemctl >/dev/null 2>&1; then
      |   skipped=1
      | else
      |   case "$(systemctl is-enabled -- "$tp_u" 2>/dev/null)" in
      |     enabled|enabled-runtime|static|alias) ;;
      |     *)
      |       systemctl enable -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; fi
      |       ;;
      |   esac
      |   if [ "$rc" -eq 0 ]; then
      |     if [ -d "$tp_run" ]; then
      |       if ! systemctl is-active --quiet -- "$tp_u"; then
      |         if [ "$(systemctl show -p NeedDaemonReload --value -- "$tp_u" 2>/dev/null)" = yes ]; then
      |           __tp_drn="${__tp_drn:+$__tp_drn,}need"
      |           systemctl daemon-reload
      |           rc=$?
      |         fi
      |         if [ "$rc" -eq 0 ]; then
      |           systemctl start -- "$tp_u"
      |           rc=$?
      |           if [ "$rc" -eq 0 ]; then changed=1; fi
      |         fi
      |       fi
      |     else
      |       tp_skip=1
      |     fi
      |   fi
      |   if [ "$rc" -eq 0 ] && [ "$changed" -eq 0 ] && [ "$tp_skip" -eq 1 ]; then skipped=1; fi
      | fi
  #3 user as shell:root reads [group:libvirt] writes [user:root] post [user:root=Exists(true)]
      | created=0
      | tp_u='root'
      | for tp_g in 'libvirt'; do
      |   if ! getent group "$tp_g" >/dev/null 2>&1; then
      |     echo "telepatch: user $tp_u: group $tp_g does not exist" >&2
      |     rc=1
      |   fi
      | done
      | if [ "$rc" -eq 0 ]; then
      | if ! getent passwd "$tp_u" >/dev/null 2>&1; then
      |   useradd -m -G 'libvirt' -- "$tp_u"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; created=1; fi
      | else
      |   :
      |   if [ "$rc" -eq 0 ]; then
      |     tp_have=" $(id -nG "$tp_u") "
      |     tp_add=
      |     tp_new=()
      |     for tp_g in 'libvirt'; do
      |       case "$tp_have" in *" $tp_g "*) ;; *) tp_add="$tp_add,$tp_g"; tp_new+=("$tp_g");; esac
      |     done
      |     if [ -n "$tp_add" ]; then
      |       usermod -aG "${tp_add#,}" -- "$tp_u"
      |       rc=$?
      |       if [ "$rc" -eq 0 ]; then changed=1; tp_gaa=("${tp_new[@]}"); fi
      |     fi
      |   fi
      | fi
      | fi
