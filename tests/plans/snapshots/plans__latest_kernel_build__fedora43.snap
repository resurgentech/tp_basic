window 3 (final)
role rust_build
  #16 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | (set -o pipefail && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y)
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #17 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo-deb; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | cargo install cargo-deb
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #18 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo-generate-rpm; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | cargo install cargo-generate-rpm
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #19 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { rustup target list --installed | grep -qx x86_64-unknown-linux-musl; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | rustup target add x86_64-unknown-linux-musl
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
role rust_kernel
  #22 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | tp_out=$(mktemp)
      | {
      | . ~/.cargo/env && rustup component add rust-src
      | } 2>&1 | tee "$tp_out"
      | rc=${PIPESTATUS[0]}
      | if [ "$rc" -eq 0 ] && grep -Eq 'downloading' "$tp_out"; then changed=1; fi
      | rm -f "$tp_out"
  #23 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if [ -e ~/.cargo/bin/bindgen ]; then
      |   skipped=1
      | else
      | . ~/.cargo/env && cargo install --locked bindgen-cli
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
