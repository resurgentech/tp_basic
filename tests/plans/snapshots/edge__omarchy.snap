---
source: tests/plans.rs
expression: text
---
host omarchy (os: Arch/Arch rolling)
blocking reads: 0
shell helpers: undo fe76955f

window 1 (final)
role edge
  #1 pkg as shell:root reads [] writes [pkg:bash, pkg:ca-certificates, pkg:curl, pkg:sh] post [pkg:bash=Installed, pkg:ca-certificates=Installed, pkg:curl=Installed, pkg:sh=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('curl' 'ca-certificates' 'bash' 'sh')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   if [ -z "$(pacman -T "$tp_n" 2>/dev/null)" ] || [ -n "$(pacman -Qqg "$tp_n" 2>/dev/null)" ]; then :; else tp_missing+=("$tp_n"); fi
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   pacman -S --needed --noconfirm "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
  -- split after #1 (pkg curl) when the host has neither curl nor wget: #3 needs a download --
  #2 file as shell:root reads [] writes [file:/usr/local/share/telepatch-edge.txt] post [file:/usr/local/share/telepatch-edge.txt=Exists(true)]
      | [ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
      | rc=0; changed=0
      | tp_p='/usr/local/share/telepatch-edge.txt'
      | tp_was "$tp_p"
      | if [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | tp_b='ZWRnZQo='
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && [ "$(printf %s "$tp_b" | base64 -d | sha256sum | cut -d' ' -f1)" = "$(sha256sum < "$tp_p" | cut -d' ' -f1)" ]; }; then
      |   if [ -e "$tp_p" ] || [ -L "$tp_p" ]; then tp_save "$tp_p" || rc=1; fi
      |   if [ "$rc" -eq 0 ]; then tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?; fi
      |   if [ "$rc" -eq 0 ]; then
      |     if printf %s "$tp_b" | base64 -d > "$tp_t"; then
      |       if [ -e "$tp_p" ]; then
      |         chmod --reference="$tp_p" "$tp_t"; chown --reference="$tp_p" "$tp_t" 2>/dev/null
      |       else
      |         chmod 644 "$tp_t"
      |       fi
      |       mv -f "$tp_t" "$tp_p"; rc=$?
      |     else
      |       rc=$?
      |     fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
      | if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '644' ]; then
      |   if chmod 644 "$tp_p"; then changed=1; else rc=$?; fi
      | fi
  #3 file as shell:root reads [] writes [file:/usr/local/bin/edge-jq] post [file:/usr/local/bin/edge-jq=Exists(true)]
      | [ "${__tp_hv-}" = fe76955f7a14ddf7 ] && declare -F tp_save >/dev/null || { echo "telepatch: shell helpers missing or stale (want fe76955f7a14ddf7)" >&2; exit 125; }
      | rc=0; changed=0
      | tp_p='/usr/local/bin/edge-jq'
      | tp_was "$tp_p"
      | tp_sbx() { [ "${TP_SANDBOX_REQUIRED-}" = 1 ] || return 0; local p s=${TP_SANDBOX-}; s=${s%/}; for p; do case $p/ in */../*) ;; /*) [ -n "$s" ] && [ -d "$s" ] && case $p/ in "$s"/*) continue;; esac;; esac; echo "telepatch: sandbox: refusing $p (TP_SANDBOX_REQUIRED is set; tests must use telepatch::testing::sandbox)" >&2; return 1; done; }
      | tp_cd="${TP_FETCH_CACHE:-/var/cache/telepatch/sha256}"
      | tp_sd="${TP_FETCH_STAGE:-/var/tmp/telepatch}"
      | tp_sbx "$tp_cd" "$tp_sd" || { tp_cd=/dev/null/refused; tp_sd=/dev/null/refused; }
      | tp_s='5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5'
      | tp_f="$tp_cd/$tp_s"; if [ -L "$tp_sd/$__tp_run/f-$tp_s" ]; then tp_f="$tp_sd/$__tp_run/f-$tp_s"; tp_r=$(readlink "$tp_f"); tp_r=${tp_r%/.telepatch/*}; tp_q=$(tp_fsroot "$tp_p"); [ "$tp_q" = "$tp_r" ] || echo 'telepatch: fetch https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64: staged on '"$tp_r, target now on $tp_q" >&2; fi
      | if [ ! -f "$tp_f" ]; then echo 'telepatch: the cached download 5942c9b0934e for https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64 is gone (a cache purge during the run?); run again to download it' >&2; rc=1; fi
      | if [ "$rc" -eq 0 ] && [ -d "$tp_p" ]; then echo "telepatch: $tp_p is a directory" >&2; rc=1; fi
      | if [ "$rc" -eq 0 ] && ! { [ -f "$tp_p" ] && [ "$(sha256sum < "$tp_p" | cut -d' ' -f1)" = "$tp_s" ]; }; then
      |   tp_t=$(mktemp "$tp_p.tpXXXXXX") || rc=$?
      |   if [ "$rc" -eq 0 ]; then
      |     cp -- "$tp_f" "$tp_t" || rc=$?
      |     if [ "$rc" -eq 0 ]; then chmod 755 "$tp_t" || rc=$?; fi
      |     if [ "$rc" -eq 0 ] && [ -e "$tp_p" ]; then chown --reference="$tp_p" "$tp_t" 2>/dev/null; fi
      |     if [ "$rc" -eq 0 ]; then tp_save "$tp_p" && mv -f "$tp_t" "$tp_p"; rc=$?; fi
      |     if [ "$rc" -eq 0 ]; then changed=1; else rm -f "$tp_t"; fi
      |   fi
      | fi
      | if [ "$rc" -eq 0 ] && [ "$(stat -L -c %a "$tp_p")" != '755' ]; then
      |   if chmod 755 "$tp_p"; then changed=1; else rc=$?; fi
      | fi
  #4 pkg[rustup] as shell:root reads [] writes [*] post [pkg:rustup:root:stable=Installed, pkg:rustup:root:stable/component/rust-src=Installed]
      | rc=0; changed=0; installed=()
      | tp_tc='stable'
      | tp_prof='default'
      | tp_path() {
      |   tp_cb=${CARGO_HOME:-$HOME/.cargo}/bin
      |   if [ -d "$tp_cb" ]; then case ":$PATH:" in *":$tp_cb:"*) ;; *) PATH=$tp_cb:$PATH;; esac; fi
      | }
      | tp_match() { awk -v t="$1" 'function tcm(f, t) { return f == t || (index(f, t "-") == 1 && substr(f, length(t) + 2) ~ /^(x86_64|i[3-6]86|aarch64|arm[0-9a-z_]*|riscv[0-9a-z]*|powerpc[0-9a-z_]*|s390x|loongarch64|mips[0-9a-z_]*|sparc[0-9a-z_]*|thumb[0-9a-z_]*|wasm[0-9]+)-[a-z0-9_]+-[a-z]/) } { if (tcm($1, t)) m=1 } END { exit m ? 0 : 1 }'; }
      | tp_ver() { rustup run "$tp_tc" rustc --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_has_tc() { rustup toolchain list 2>/dev/null | tp_match "$tp_tc"; }
      | tp_updates() { awk -v t="$tp_tc" 'function tcm(f, t) { return f == t || (index(f, t "-") == 1 && substr(f, length(t) + 2) ~ /^(x86_64|i[3-6]86|aarch64|arm[0-9a-z_]*|riscv[0-9a-z]*|powerpc[0-9a-z_]*|s390x|loongarch64|mips[0-9a-z_]*|sparc[0-9a-z_]*|thumb[0-9a-z_]*|wasm[0-9]+)-[a-z0-9_]+-[a-z]/) } /[Uu]pdate available/ { if ($1 == "rustup") print "self"; else if (tcm($1, t)) { v=$0; sub(/.*-> */, "", v); split(v, a, " "); print "tc " a[1] } }'; }
      | tp_check() { tp_chk=$(rustup check 2>&1); tp_crc=$?; [ "$tp_crc" -eq 0 ] || [ "$tp_crc" -eq 100 ]; }
      | tp_path
      | tp_fresh=0
      | if ! command -v rustup >/dev/null 2>&1; then
      |   ( set -o pipefail; curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "$tp_tc" --profile "$tp_prof" )
      |   rc=$?
      |   tp_path
      |   if [ "$rc" -eq 0 ] && ! command -v rustup >/dev/null 2>&1; then echo 'telepatch: rustup not found after the installer' >&2; rc=1; fi
      |   if [ "$rc" -eq 0 ]; then tp_fresh=1; fi
      | elif ! tp_has_tc; then
      |   rustup toolchain install "$tp_tc" --profile "$tp_prof"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then tp_fresh=1; fi
      | fi
      | if [ "$tp_fresh" -eq 1 ]; then
      |   if tp_has_tc; then changed=1; installed+=("$tp_tc"); else echo "telepatch: rustup toolchain $tp_tc: not installed afterwards" >&2; rc=1; fi
      | fi
      | if [ "$rc" -eq 0 ]; then
      |   tp_have=$(rustup component list --installed --toolchain "$tp_tc" 2>/dev/null)
      |   tp_miss=()
      |   for tp_x in 'rust-src'; do
      |     printf '%s\n' "$tp_have" | tp_match "$tp_x" || tp_miss+=("$tp_x")
      |   done
      |   if [ "${#tp_miss[@]}" -gt 0 ]; then
      |     rustup component add --toolchain "$tp_tc" "${tp_miss[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then
      |       changed=1
      |       for tp_x in "${tp_miss[@]}"; do installed+=("$tp_tc/component/$tp_x"); done
      |     fi
      |   fi
      | fi
