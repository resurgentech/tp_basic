---
source: tests/plans.rs
expression: text
---
host amazonlinux2023 (os: RedHat/Amazon 2023)
blocking reads: 2

window 1 (implicit barrier)
role dev_common
  #1 pkg as shell:root reads [] writes [pkg:@Development Tools, pkg:bc, pkg:clang, pkg:cmake, pkg:gcc, pkg:git, pkg:lld, pkg:llvm, pkg:net-tools, pkg:newt, pkg:python3, pkg:python3-devel, pkg:python3-pip, pkg:rpm-build, pkg:rsync, pkg:slang, pkg:wget, pkg:xmlto, pkg:zlib-devel, pkg:zstd] post [pkg:@Development Tools=Installed, pkg:bc=Installed, pkg:clang=Installed, pkg:cmake=Installed, pkg:gcc=Installed, pkg:git=Installed, pkg:lld=Installed, pkg:llvm=Installed, pkg:net-tools=Installed, pkg:newt=Installed, pkg:python3=Installed, pkg:python3-devel=Installed, pkg:python3-pip=Installed, pkg:rpm-build=Installed, pkg:rsync=Installed, pkg:slang=Installed, pkg:wget=Installed, pkg:xmlto=Installed, pkg:zlib-devel=Installed, pkg:zstd=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('@Development Tools' 'cmake' 'clang' 'llvm' 'lld' 'git' 'rsync' 'gcc' 'zlib-devel' 'bc' 'newt' 'slang' 'xmlto' 'net-tools' 'rpm-build' 'zstd' 'wget' 'python3' 'python3-devel' 'python3-pip')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   case "$tp_n" in
      |     @*) dnf group list --installed 2>/dev/null | grep -qF -- "${tp_n#@}" || tp_missing+=("$tp_n");;
      |     *) rpm -q --whatprovides "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n");;
      |   esac
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   dnf install -y "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
  #2 pkg as shell:root reads [] writes [pkg:pip:GitPython, pkg:pip:jinja2, pkg:pip:pyaml] post [pkg:pip:GitPython=Installed, pkg:pip:jinja2=Installed, pkg:pip:pyaml=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('jinja2' 'GitPython' 'pyaml')
      | tp_missing=()
      | if python3 -m pip --version >/dev/null 2>&1; then tp_pip=(python3 -m pip)
      | elif command -v pip3 >/dev/null 2>&1; then tp_pip=(pip3)
      | else echo 'telepatch: pip not found' >&2; rc=127; fi
      | if [ "$rc" -eq 0 ]; then
      |   for tp_n in "${tp_want[@]}"; do
      |     "${tp_pip[@]}" show "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n")
      |   done
      |   if [ "${#tp_missing[@]}" -gt 0 ]; then
      |     "${tp_pip[@]}" install "${tp_missing[@]}"
      |     rc=$?
      |     if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      |   fi
      | fi
  #3 pkg[script] as shell:root reads [] writes [*] post [pkg:script:root:uv=Installed, file:/usr/local/bin/uv=Exists(true)]
      | rc=0; changed=0; installed=()
      | tp_name='uv'
      | tp_tok() { grep -oE '[0-9]+(\.[0-9A-Za-z+~-]+)*' | head -n1; }
      | tp_probe() {
      |   tp_have=0; tp_v=
      |   if [ -x '/usr/local/bin/uv' ]; then
      |     tp_have=1
      |     tp_v=$( (
      | uv self version --short
      | ) 2>/dev/null | tp_tok)
      |   fi
      | }
      | tp_want_v=
      | tp_probe
      | tp_had=$tp_have; tp_before=$tp_v; tp_act=
      | if [ "$rc" -eq 0 ]; then
      |   if [ "$tp_have" -eq 0 ]; then tp_act=install
      |   elif [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; then tp_act=update
      |   fi
      | fi
      | if [ "$tp_act" = install ]; then
      |   ( export TP_WANT="$tp_want_v"
      | (set -o pipefail && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/local/bin sh)
      |   )
      |   rc=$?
      | elif [ "$tp_act" = update ]; then
      |   ( export TP_WANT="$tp_want_v"
      | uv self update
      |   )
      |   rc=$?
      | fi
      | if [ -n "$tp_act" ]; then
      |   tp_probe
      |   if [ "$tp_have" -ne "$tp_had" ] || [ "$tp_v" != "$tp_before" ]; then changed=1; installed=("$tp_name"); fi
      |   if [ "$rc" -eq 0 ]; then
      |     if [ "$tp_have" -eq 0 ]; then tp_got=absent; else tp_got=${tp_v:-unknown}; fi
      |     if [ "$tp_have" -eq 0 ] || { [ -n "$tp_want_v" ] && [ "$tp_v" != "$tp_want_v" ]; }; then
      |       echo "telepatch: script $tp_name: installed $tp_got, wanted ${tp_want_v:-present}" >&2; rc=1
      |     fi
      |   fi
      | fi
role kernel_build
  #8 pkg as shell:root reads [] writes [pkg:audit-libs-devel, pkg:binutils-devel, pkg:bpftool, pkg:clang, pkg:dwarves, pkg:elfutils-devel, pkg:elfutils-libelf-devel, pkg:gcc-c++, pkg:libbpf-devel, pkg:libcap-devel, pkg:libcap-ng-devel, pkg:libmnl-devel, pkg:ncurses-devel, pkg:newt-devel, pkg:numactl-devel, pkg:openssl-devel, pkg:pciutils-devel, pkg:perl(ExtUtils::Embed), pkg:perl-Carp, pkg:perl-devel, pkg:perl-generators, pkg:perl-interpreter, pkg:pkgconf-pkg-config, pkg:python3-sphinx, pkg:rpm-build, pkg:rpmdevtools, pkg:xz-devel, pkg:zlib-devel] post [pkg:audit-libs-devel=Installed, pkg:binutils-devel=Installed, pkg:bpftool=Installed, pkg:clang=Installed, pkg:dwarves=Installed, pkg:elfutils-devel=Installed, pkg:elfutils-libelf-devel=Installed, pkg:gcc-c++=Installed, pkg:libbpf-devel=Installed, pkg:libcap-devel=Installed, pkg:libcap-ng-devel=Installed, pkg:libmnl-devel=Installed, pkg:ncurses-devel=Installed, pkg:newt-devel=Installed, pkg:numactl-devel=Installed, pkg:openssl-devel=Installed, pkg:pciutils-devel=Installed, pkg:perl(ExtUtils::Embed)=Installed, pkg:perl-Carp=Installed, pkg:perl-devel=Installed, pkg:perl-generators=Installed, pkg:perl-interpreter=Installed, pkg:pkgconf-pkg-config=Installed, pkg:python3-sphinx=Installed, pkg:rpm-build=Installed, pkg:rpmdevtools=Installed, pkg:xz-devel=Installed, pkg:zlib-devel=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('rpmdevtools' 'rpm-build' 'audit-libs-devel' 'binutils-devel' 'elfutils-devel' 'elfutils-libelf-devel' 'libcap-devel' 'ncurses-devel' 'newt-devel' 'numactl-devel' 'openssl-devel' 'pciutils-devel' 'xz-devel' 'zlib-devel' 'perl-interpreter' 'perl-devel' 'perl-generators' 'perl-Carp' 'perl(ExtUtils::Embed)' 'python3-sphinx' 'dwarves' 'libbpf-devel' 'libcap-ng-devel' 'libmnl-devel' 'bpftool' 'gcc-c++' 'pkgconf-pkg-config' 'clang')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   case "$tp_n" in
      |     @*) dnf group list --installed 2>/dev/null | grep -qF -- "${tp_n#@}" || tp_missing+=("$tp_n");;
      |     *) rpm -q --whatprovides "$tp_n" >/dev/null 2>&1 || tp_missing+=("$tp_n");;
      |   esac
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   dnf install -y "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
      merged from kernel_build #8, rust_build #11

window 3 (final)
role rust_build
  #14 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | (set -o pipefail && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y)
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #15 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo-deb; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | cargo install cargo-deb
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #16 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { command -v cargo-generate-rpm; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | cargo install cargo-generate-rpm
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
  #17 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if { rustup target list --installed | grep -qx x86_64-unknown-linux-musl; } >/dev/null 2>&1; then
      |   skipped=1
      | else
      | rustup target add x86_64-unknown-linux-musl
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
role rust_kernel
  #20 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | tp_out=$(mktemp)
      | {
      | . ~/.cargo/env && rustup component add rust-src
      | } 2>&1 | tee "$tp_out"
      | rc=${PIPESTATUS[0]}
      | if [ "$rc" -eq 0 ] && grep -Eq 'downloading' "$tp_out"; then changed=1; fi
      | rm -f "$tp_out"
  #21 sh as login:root reads [] writes [*]
      | rc=0; changed=0; skipped=0
      | if [ -e ~/.cargo/bin/bindgen ]; then
      |   skipped=1
      | else
      | . ~/.cargo/env && cargo install --locked bindgen-cli
      | rc=$?
      | if [ "$rc" -eq 0 ]; then changed=1; fi
      | fi
