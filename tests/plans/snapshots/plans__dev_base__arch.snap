  #1 pkg as shell:root reads [] writes [pkg:base-devel, pkg:bc, pkg:clang, pkg:cmake, pkg:cpio, pkg:git, pkg:gnupg, pkg:lld, pkg:llvm, pkg:python, pkg:python-gitpython, pkg:python-jinja, pkg:python-pip, pkg:python-pytest, pkg:python-yaml, pkg:rsync, pkg:wget, pkg:xmlto, pkg:zstd] post [pkg:base-devel=Installed, pkg:bc=Installed, pkg:clang=Installed, pkg:cmake=Installed, pkg:cpio=Installed, pkg:git=Installed, pkg:gnupg=Installed, pkg:lld=Installed, pkg:llvm=Installed, pkg:python=Installed, pkg:python-gitpython=Installed, pkg:python-jinja=Installed, pkg:python-pip=Installed, pkg:python-pytest=Installed, pkg:python-yaml=Installed, pkg:rsync=Installed, pkg:wget=Installed, pkg:xmlto=Installed, pkg:zstd=Installed]
      | rc=0; changed=0; installed=()
      | tp_want=('base-devel' 'cmake' 'clang' 'llvm' 'lld' 'git' 'rsync' 'gnupg' 'bc' 'cpio' 'xmlto' 'zstd' 'wget' 'python' 'python-pip' 'python-yaml' 'python-jinja' 'python-gitpython' 'python-pytest')
      | tp_missing=()
      | for tp_n in "${tp_want[@]}"; do
      |   if [ -z "$(pacman -T "$tp_n" 2>/dev/null)" ] || [ -n "$(pacman -Qqg "$tp_n" 2>/dev/null)" ]; then :; else tp_missing+=("$tp_n"); fi
      | done
      | if [ "${#tp_missing[@]}" -gt 0 ]; then
      |   pacman -S --needed --noconfirm "${tp_missing[@]}"
      |   rc=$?
      |   if [ "$rc" -eq 0 ]; then changed=1; installed=("${tp_missing[@]}"); fi
      | fi
